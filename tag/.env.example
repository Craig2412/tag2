APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REVERB_APP_ID=123456
REVERB_APP_KEY=your_reverb_key
REVERB_APP_SECRET=your_reverb_secret
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Scribe & Internal Auth (Next.js)
SCRIBE_AUTH_TOKEN=
INTERNAL_CONTRACT_SECRET=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

KIU_SANDBOX=true
KIU_BASE_URL=https://ssl00.kiusys.com/ws3/index.php
KIU_TRANSPORT=form_params
KIU_TIMEOUT=30
KIU_VERIFY_SSL=true
KIU_ACCEPT_HEADER="application/xml, text/xml, */*"
KIU_CONTENT_TYPE=application/x-www-form-urlencoded
KIU_USERNAME=
KIU_PASSWORD=
KIU_OFFICE_ID=
KIU_AGENT_SINE=

KIU_SESSION_PATH=/
KIU_SESSION_SOAP_ACTION=
KIU_SESSION_TRANSPORT=form_params

KIU_AVAILABILITY_PATH=/
KIU_AVAILABILITY_SOAP_ACTION=
KIU_AVAILABILITY_TRANSPORT=form_params

KIU_PRICING_PATH=/
KIU_PRICING_SOAP_ACTION=
KIU_PRICING_TRANSPORT=form_params

KIU_BOOKING_PATH=/
KIU_BOOKING_SOAP_ACTION=
KIU_BOOKING_TRANSPORT=form_params

KIU_TICKETING_PATH=/
KIU_TICKETING_SOAP_ACTION=
KIU_TICKETING_TRANSPORT=form_params

KIU_POST_SALE_PATH=/
KIU_POST_SALE_SOAP_ACTION=
KIU_POST_SALE_TRANSPORT=form_params

VITE_APP_NAME="${APP_NAME}"

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REVERB_APP_ID=123456
REVERB_APP_KEY=your_reverb_key
REVERB_APP_SECRET=your_reverb_secret
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http

# Scribe & Internal Auth (Next.js)
SCRIBE_AUTH_TOKEN=
INTERNAL_CONTRACT_SECRET=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

KIU_SANDBOX=true
KIU_BASE_URL=https://kws.kiusys.com/ws3_training/index.php
#KIU_BASE_URL= https://ssl00.kiusys.com/ws3/index.php
KIU_TRANSPORT=xml
KIU_TIMEOUT=30
KIU_VERIFY_SSL=true
KIU_AUTH_MODE=none
KIU_USERNAME=
KIU_PASSWORD=
KIU_OFFICE_ID=
KIU_AGENT_SINE=
KIU_HEADER_USERNAME=X-KIU-Username
KIU_HEADER_PASSWORD=X-KIU-Password
KIU_HEADER_OFFICE_ID=X-KIU-Office-Id
KIU_HEADER_AGENT_SINE=X-KIU-Agent-Sine
KIU_ACCEPT_HEADER=application/xml
KIU_SESSION_PATH=/session
KIU_SESSION_SOAP_ACTION=
KIU_AVAILABILITY_PATH=/availability
KIU_AVAILABILITY_SOAP_ACTION=
KIU_PRICING_PATH=/pricing
KIU_PRICING_SOAP_ACTION=
KIU_BOOKING_PATH=/booking
KIU_BOOKING_SOAP_ACTION=
KIU_TICKETING_PATH=/ticketing
KIU_TICKETING_SOAP_ACTION=
KIU_POST_SALE_PATH=/post-sale
KIU_POST_SALE_SOAP_ACTION=

VITE_APP_NAME="${APP_NAME}"
